class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size();
        unordered_map<int,int> check;
        for(int i=0 ; i<n ; i++){
            int diff= target-nums[i];
            if(check.count(diff)){
                return {check[diff],i};
            } 
            check[nums[i]]=i;
        }
        return{};
    }
};
