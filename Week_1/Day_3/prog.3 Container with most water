class Solution {
public:
    int maxArea(vector<int>& height) {
        int n= height.size();
        int left=0;
        int right=n-1;
        int max_area=0;
        while(left<right){
            int l=min(height[left],height[right]);
            int b=right-left;
            int area=l*b;
            max_area=max(max_area,area);
            if(height[left]<height[right]) left++;
            else right--;
        }
        return max_area;
        
    }
};
