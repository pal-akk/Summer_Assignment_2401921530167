class Solution {
public:
    bool isPalindrome(string s) {
        string t="";
        for(char ch :s){
            if(isalpha(ch)) t+=tolower(ch);
            if(isdigit(ch)) t+=ch;
        }
        int n=t.size();
        for(int i=0 ; i<n ; i++){
            if(t[i]!=t[n-i-1]) return false;
        }
        return true;
        
    }
};
