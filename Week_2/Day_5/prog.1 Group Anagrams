class Solution {
public:
    bool checkValidString(string s) {
        stack<int> par;
        stack<int> alt;
        for(int i=0 ; i<s.size();i++){
            if(s[i]=='(') par.push(i);
            else if(s[i]=='*') alt.push(i);
            else if(s[i]==')'){
                if(!par.empty()){
                    par.pop();
                }
                else if(!alt.empty()){
                    alt.pop();
                }
                else return false;
            }

        }
        while(!par.empty() && !alt.empty()){
            if(par.top()>alt.top()) return false;
            par.pop();
            alt.pop();
        }
        return par.empty();
        
    }
};
