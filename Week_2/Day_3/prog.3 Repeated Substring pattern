class Solution {
public:
    bool repeatedSubstringPattern(string s) {
        int n=s.size();
        for(int i=1 ;i<=n/2;i++){
            if(n%i != 0) continue;
            string sub= s.substr(0,i);
            string add="";
            for(int j=0 ; j<n/i ;j++){
                add+=sub;
            }
            if(s == add) return true;
        }
        return false;
    }
};
