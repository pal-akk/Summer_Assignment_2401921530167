class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        int n=s1.size();
        int m=s2.size();
        if(n>m) return false;
        vector<int> freq(26,0) ,check(26,0);
        for(int i=0 ;i<n ; i++){
            freq[s1[i]-'a']++;
            check[s2[i]-'a']++;
        }
        if(freq==check) return true;
        int r=n;
        string s= s2.substr(0,r);
        for(int i=n ; i<m ;i++){
            check[s2[i]-'a']++;
            check[s2[i-n]-'a']--;
            if(check==freq) return true;
        }
        return false;
    }
};
