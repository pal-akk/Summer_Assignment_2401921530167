class Solution {
public:
    string decodeString(string s) {
        stack<int> freq;
        stack<string> st;
        int num=0;
        string curr="";
        for(char ch: s){
            if(isdigit(ch)){
                num=num*10 + (ch-'0');
            }
            else if(ch=='['){
                freq.push(num);
                st.push(curr);

                num=0;
                curr="";
            }
            else if(ch==']'){
                string temp=curr;
                curr=st.top();
                st.pop();
                int tyms =freq.top();
                freq.pop();
                while(tyms--){
                    curr+=temp;
                }
            }
            else curr+=ch; 
        }
        return curr;
    }
};
