class Solution {
public:
    bool isValid(string s) {
        stack<int> stk;
        for(char ch : s){
            if(ch=='(' || ch=='[' || ch=='{'){
                stk.push(ch);
            }
            else{
                if(stk.size()==0) return false;
                char t=stk.top();
                stk.pop();
                if(ch==')' && t!='(' || ch==']' && t!='[' || ch=='}' && t!='{') return false;
            }
        }
        return stk.size()==0;        
    }
};
