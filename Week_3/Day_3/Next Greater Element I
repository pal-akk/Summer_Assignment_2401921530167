class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        int n= nums2.size();
        stack<int> stk;
        unordered_map<int,int> rec;
        vector<int> res;
        for(int i=n-1 ; i>=0 ; i--){
            while(!stk.empty() && nums2[i]>=stk.top()){
                stk.pop();
            }
            if(stk.empty()) rec[nums2[i]]=-1;
            else{
                rec[nums2[i]]=stk.top();
            }
            stk.push(nums2[i]);
        }
        for(int x : nums1){
            res.push_back(rec[x]);
        }
        return res;
    }
};
