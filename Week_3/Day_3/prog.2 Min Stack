class MinStack {
public:
    stack<long long> stk;
    long long mini;
    MinStack() {
        
    }
    
    void push(int value) {
        if(stk.empty()){
            stk.push(value);
            mini=value;
        }
        else{
            if(value<mini){
                stk.push(2LL*value-mini);
                mini=value;
            }
            else{
                stk.push(value);
            }
        }
    }
    
    void pop() {
        if(!stk.empty()){
            long long  val=stk.top();
            stk.pop();
            if(val<mini){
                mini=2*mini-val;
            }
        }
        
    }
    
    int top() {
        long long val=stk.top();
        if(val<mini){
            return mini;
        }
        else return val;
        
    }
    
    int getMin() {
        return mini;
        
    }
};

