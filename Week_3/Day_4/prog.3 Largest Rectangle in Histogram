class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int n= heights.size();
        int maxarea=0;
        stack<int> stk;
        for(int i=0 ;i<=n ;i++){
            while(!stk.empty() && (i==n || heights[stk.top()]>heights[i])){
                int height=heights[stk.top()];
                stk.pop();
                int right=i;
                int left=stk.empty()?-1:stk.top();
                maxarea=max((height*(right-left-1)),maxarea);
            }
            stk.push(i);
        }
        return maxarea;
        
    }
};
